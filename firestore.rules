rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedAccount() {
      return signedIn()
        && (request.auth.token.firebase.sign_in_provider == 'phone'
          || request.auth.token.email_verified == true);
    }

    function ownerAdmin() {
      return verifiedAccount()
        && request.auth.uid == 'LROHsLUXfEPnC6bDmSvy3vcRnNE3';
    }

    function isVendor() {
      return verifiedAccount()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Vendor';
    }

    function isGoldenChatParticipant(chatId) {
      return verifiedAccount()
        && request.auth.uid in get(
          /databases/$(database)/documents/goldenChats/$(chatId)
        ).data.participantIds;
    }

    function validUserProfile(data) {
      return data.keys().hasOnly([
          'uid',
          'name',
          'role',
          'createdAt',
          'profilePhotoPath',
          'allowMediaDownloads',
          'followersPrivate',
          'followingPrivate',
          'location',
          'gender',
          'ageRange',
          'description',
          'verifiedDealerUntil',
          'verifiedDealerAutoRenew',
          'verifiedDealerAutoRenewPaused',
          'verifiedDealerRenewalDueAt'
        ])
        && data.uid == request.auth.uid
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.role in ['Buyer', 'Vendor']
        && (!data.keys().hasAny(['allowMediaDownloads'])
          || data.allowMediaDownloads is bool)
        && (!data.keys().hasAny(['followersPrivate'])
          || data.followersPrivate is bool)
        && (!data.keys().hasAny(['followingPrivate'])
          || data.followingPrivate is bool)
        && (!data.keys().hasAny(['profilePhotoPath'])
          || (data.profilePhotoPath is string
            && data.profilePhotoPath.size() <= 180
            && (data.profilePhotoPath == ''
              || data.profilePhotoPath.matches(
                '^profile-photos/' + request.auth.uid + '/[A-Za-z0-9_-]+$'
              ))))
        && (!data.keys().hasAny(['location'])
          || (data.location is string && data.location.size() <= 160))
        && (!data.keys().hasAny(['gender'])
          || data.gender in ['', 'Woman', 'Man', 'Non-binary', 'Prefer not to say'])
        && (!data.keys().hasAny(['ageRange'])
          || data.ageRange in ['', 'Under 18', '18-24', '25-34', '35-44', '45-54', '55+'])
        && (!data.keys().hasAny(['description'])
          || (data.description is string && data.description.size() <= 1000))
        && (!data.keys().hasAny(['verifiedDealerUntil'])
          || data.verifiedDealerUntil is timestamp)
        && (!data.keys().hasAny(['verifiedDealerAutoRenew'])
          || data.verifiedDealerAutoRenew is bool)
        && (!data.keys().hasAny(['verifiedDealerAutoRenewPaused'])
          || data.verifiedDealerAutoRenewPaused is bool)
        && (!data.keys().hasAny(['verifiedDealerRenewalDueAt'])
          || data.verifiedDealerRenewalDueAt is timestamp);
    }

    function validProduct(data) {
      return data.keys().hasOnly([
          'ownerUid',
          'id',
          'title',
          'category',
          'price',
          'stock',
          'imageUrl',
          'imageUrls',
          'videoUrl',
          'shortDesc',
          'fullDesc',
          'vendorName',
          'vendorLocation',
          'vendorContact',
          'rating',
          'createdAt',
          'boostedUntil'
        ])
        && data.ownerUid is string
        && data.id is string
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.category is string
        && data.price is number
        && data.price > 0
        && data.stock is int
        && data.stock >= 0
        && data.imageUrl is string
        && data.imageUrl.size() <= 2048
        && (!data.keys().hasAny(['imageUrls'])
          || data.imageUrls is list)
        && (!data.keys().hasAny(['videoUrl'])
          || (data.videoUrl is string && data.videoUrl.size() <= 2048))
        && (data.imageUrl.size() > 0
          || (data.keys().hasAny(['imageUrls'])
            && data.imageUrls is list && data.imageUrls.size() > 0)
          || (data.keys().hasAny(['videoUrl']) && data.videoUrl.size() > 0))
        && data.shortDesc is string
        && data.shortDesc.size() <= 500
        && data.fullDesc is string
        && data.fullDesc.size() <= 3000
        && data.vendorName is string
        && data.vendorName.size() <= 120
        && data.vendorLocation is string
        && data.vendorLocation.size() <= 200
        && data.vendorContact is string
        && data.vendorContact.size() <= 80
        && data.rating is number
        && data.createdAt is string
        && (!data.keys().hasAny(['boostedUntil'])
          || data.boostedUntil is timestamp);
    }

    match /users/{userId} {
      allow get: if verifiedAccount();
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny([
          'verifiedDealerUntil',
          'verifiedDealerAutoRenew',
          'verifiedDealerAutoRenewPaused',
          'verifiedDealerRenewalDueAt'
        ])
        && validUserProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if verifiedAccount()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'profilePhotoPath',
          'allowMediaDownloads',
          'followersPrivate',
          'followingPrivate',
          'location',
          'gender',
          'ageRange',
          'description'
        ])
        && validUserProfile(request.resource.data)
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /following/{memberId} {
        allow get, list: if verifiedAccount()
          && (request.auth.uid == userId
            || get(/databases/$(database)/documents/users/$(userId)).data.get('followingPrivate', false) != true);
        allow create: if verifiedAccount()
          && request.auth.uid == userId
          && memberId != request.auth.uid
          && exists(/databases/$(database)/documents/users/$(memberId))
          && get(/databases/$(database)/documents/users/$(memberId)).data.role in ['Buyer', 'Vendor']
          && (
            (request.resource.data.keys().hasOnly([
              'memberUid',
              'memberName',
              'memberRole',
              'createdAt'
            ])
              && request.resource.data.keys().hasAll([
                'memberUid',
                'memberName',
                'memberRole',
                'createdAt'
              ])
              && request.resource.data.memberUid == memberId
              && request.resource.data.memberName is string
              && request.resource.data.memberName.size() > 0
              && request.resource.data.memberName.size() <= 120
              && request.resource.data.memberRole
                == get(/databases/$(database)/documents/users/$(memberId)).data.role)
            || (request.resource.data.keys().hasOnly([
              'vendorUid',
              'vendorName',
              'createdAt'
            ])
              && request.resource.data.vendorUid == memberId
              && get(/databases/$(database)/documents/users/$(memberId)).data.role == 'Vendor'
              && request.resource.data.vendorName is string
              && request.resource.data.vendorName.size() > 0
              && request.resource.data.vendorName.size() <= 120)
          )
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if verifiedAccount() && request.auth.uid == userId;
      }

      match /followers/{followerId} {
        allow get: if verifiedAccount()
          && (request.auth.uid == userId
            || request.auth.uid == followerId
            || get(/databases/$(database)/documents/users/$(userId)).data.get('followersPrivate', false) != true);
        allow list: if verifiedAccount()
          && (request.auth.uid == userId
            || get(/databases/$(database)/documents/users/$(userId)).data.get('followersPrivate', false) != true);
        allow create: if verifiedAccount()
          && request.auth.uid == followerId
          && userId != request.auth.uid
          && get(/databases/$(database)/documents/users/$(userId)).data.role in ['Buyer', 'Vendor']
          && request.resource.data.keys().hasOnly([
            'followerUid',
            'followerName',
            'followerRole',
            'createdAt'
          ])
          && request.resource.data.followerUid == request.auth.uid
          && request.resource.data.followerName
            == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
          && request.resource.data.followerRole
            == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          && request.resource.data.followerRole in ['Buyer', 'Vendor']
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if verifiedAccount() && request.auth.uid == followerId;
      }

      match /verifiedDealerRenewals/{renewalId} {
        allow read, write: if false;
      }

      match /productBoostPurchases/{purchaseId} {
        allow read, write: if false;
      }

      match /stockAlertBroadcasts/{broadcastId} {
        allow get, list: if verifiedAccount() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow get, list: if verifiedAccount() && request.auth.uid == userId;
        allow create, delete: if false;
        allow update: if verifiedAccount()
          && request.auth.uid == userId
          && !resource.data.keys().hasAny(['readAt'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
      }
    }

    match /presence/{userId}/sessions/{sessionId} {
      allow get, list: if true;
      allow create, update: if verifiedAccount()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['active', 'lastSeen'])
        && request.resource.data.keys().hasAll(['active', 'lastSeen'])
        && request.resource.data.active is bool
        && request.resource.data.lastSeen == request.time;
      allow delete: if verifiedAccount() && request.auth.uid == userId;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isVendor()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == productId
        && !request.resource.data.keys().hasAny(['boostedUntil'])
        && validProduct(request.resource.data);
      allow update: if isVendor()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.id == resource.data.id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'category',
          'price',
          'stock',
          'imageUrl',
          'imageUrls',
          'shortDesc',
          'fullDesc',
          'vendorName',
          'vendorLocation',
          'vendorContact'
        ])
        && validProduct(request.resource.data);
      allow delete: if isVendor() && resource.data.ownerUid == request.auth.uid;
    }

    match /verifiedDealers/{vendorUid} {
      allow read: if true;
      allow write: if false;
    }

    function validCommunityPost(data, postId) {
      return data.keys().hasOnly([
          'id',
          'ownerUid',
          'ownerName',
          'caption',
          'imageUrls',
          'videoUrl',
          'mediaOwnerUid',
          'mediaOwnerName',
          'repostOf',
          'repostOwnerUid',
          'createdAt'
        ])
        && data.id == postId
        && data.ownerUid == request.auth.uid
        && data.ownerName is string
        && data.ownerName.size() > 0
        && data.ownerName.size() <= 120
        && data.caption is string
        && data.caption.size() <= 1000
        && data.imageUrls is list
        && data.videoUrl is string
        && data.videoUrl.size() <= 2048
        && data.mediaOwnerUid is string
        && data.mediaOwnerName is string
        && data.mediaOwnerName.size() <= 120
        && data.createdAt is timestamp
        && (data.imageUrls.size() > 0 || data.videoUrl.size() > 0);
    }

    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if verifiedAccount()
        && validCommunityPost(request.resource.data, postId)
        && ((!request.resource.data.keys().hasAny(['repostOf'])
            && request.resource.data.mediaOwnerUid == request.auth.uid)
          || (request.resource.data.keys().hasAny(['repostOf'])
            && request.resource.data.repostOf is string
            && request.resource.data.repostOwnerUid is string
            && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.repostOf))
            && request.resource.data.repostOwnerUid
              == get(/databases/$(database)/documents/communityPosts/$(request.resource.data.repostOf)).data.ownerUid
            && request.resource.data.mediaOwnerUid
              == get(/databases/$(database)/documents/communityPosts/$(request.resource.data.repostOf)).data.mediaOwnerUid
            && request.resource.data.imageUrls
              == get(/databases/$(database)/documents/communityPosts/$(request.resource.data.repostOf)).data.imageUrls
            && request.resource.data.videoUrl
              == get(/databases/$(database)/documents/communityPosts/$(request.resource.data.repostOf)).data.videoUrl));
      allow update: if false;
      allow delete: if verifiedAccount() && resource.data.ownerUid == request.auth.uid;
    }

    match /communityPosts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if verifiedAccount()
        && exists(/databases/$(database)/documents/communityPosts/$(postId))
        && request.resource.data.keys().hasOnly([
          'authorUid',
          'authorName',
          'text',
          'voicePath',
          'parentCommentId',
          'createdAt'
        ])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 120
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && (!request.resource.data.keys().hasAny(['voicePath'])
          || (request.resource.data.voicePath is string
            && request.resource.data.voicePath
              == 'community-comment-voice/' + postId + '/' + commentId
                + '/' + request.auth.uid + '/voice'))
        && (!request.resource.data.keys().hasAny(['parentCommentId'])
          || (request.resource.data.parentCommentId is string
            && request.resource.data.parentCommentId.matches('^[A-Za-z0-9_-]{1,128}$')
            && request.resource.data.parentCommentId != commentId
            && exists(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(request.resource.data.parentCommentId))))
        && (request.resource.data.text.size() > 0
          || request.resource.data.keys().hasAny(['voicePath']))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if verifiedAccount() && resource.data.authorUid == request.auth.uid;

      match /likes/{userId} {
        allow get: if verifiedAccount() && request.auth.uid == userId;
        allow list, create, update, delete: if false;
      }
    }

    match /communityPosts/{postId}/likes/{userId} {
      allow get: if verifiedAccount() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /communityPostStats/{postId} {
      allow read: if true;
      allow write: if false;
    }

    match /productDiscussionStats/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /escrowOrders/{orderId} {
      allow read: if verifiedAccount()
        && (request.auth.uid == resource.data.buyerUid
          || request.auth.uid == resource.data.vendorUid
          || ownerAdmin());
      allow write: if false;
    }

    match /escrowPendingPayments/{paymentId} {
      allow read, write: if false;
    }

    match /escrowPaymentTransactions/{transactionId} {
      allow read, write: if false;
    }

    match /storeVouchers/{code} {
      allow read, write: if false;
    }

    match /voucherOptIns/{id} {
      allow read, write: if false;
    }

    match /voucherRedemptions/{id} {
      allow read, write: if false;
    }

    match /escrowReleases/{orderId} {
      allow read, write: if false;
    }

    match /escrowRefunds/{orderId} {
      allow read, write: if false;
    }

    match /escrowPlatformAccounting/{accountId} {
      allow read, write: if false;
    }

    match /vendorPayoutBalances/{vendorUid} {
      allow get: if verifiedAccount() && request.auth.uid == vendorUid;
      allow list, write: if false;
    }

    match /escrowWithdrawals/{withdrawalId} {
      allow read: if verifiedAccount()
        && (request.auth.uid == resource.data.vendorUid
          || ownerAdmin());
      allow write: if false;
    }

    match /escrowVendorBankAccounts/{vendorUid} {
      allow read, write: if false;
    }

    match /quizWallets/{userId} {
      allow get: if verifiedAccount() && request.auth.uid == userId;
      allow list: if false;
      allow write: if false;
    }

    match /quizQuestions/{questionId} {
      allow read, write: if false;
    }

    match /quizDailyUsage/{usageId} {
      allow read, write: if false;
    }

    match /quizAttempts/{attemptId} {
      allow read, write: if false;
    }

    match /goldenChats/{chatId} {
      allow get, list: if verifiedAccount()
        && request.auth.uid in resource.data.participantIds;
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow get, list: if isGoldenChatParticipant(chatId);
        allow create, update, delete: if false;
      }
    }

    function callParticipant(data) {
      return verifiedAccount()
        && (request.auth.uid == data.callerUid || request.auth.uid == data.calleeUid);
    }

    function validCallDescription(value, descriptionType) {
      return value is map
        && value.keys().hasOnly(['type', 'sdp'])
        && value.keys().hasAll(['type', 'sdp'])
        && value.type == descriptionType
        && value.sdp is string && value.sdp.size() > 0 && value.sdp.size() <= 65536;
    }

    function validCallCandidate(data) {
      return data.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex'])
        && data.keys().hasAll(['candidate', 'sdpMid', 'sdpMLineIndex'])
        && data.candidate is string && data.candidate.size() > 0 && data.candidate.size() <= 4096
        && (data.sdpMid == null || (data.sdpMid is string && data.sdpMid.size() <= 256))
        && (data.sdpMLineIndex == null || (data.sdpMLineIndex is int && data.sdpMLineIndex >= 0));
    }

    match /calls/{callId} {
      allow get, list: if callParticipant(resource.data);
      allow create: if verifiedAccount()
        && request.resource.data.keys().hasOnly([
          'chatId', 'callerUid', 'calleeUid', 'type', 'status', 'offer', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'chatId', 'callerUid', 'calleeUid', 'type', 'status', 'offer', 'createdAt'
        ])
        && request.resource.data.chatId is string
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid != request.auth.uid
        && isGoldenChatParticipant(request.resource.data.chatId)
        && get(/databases/$(database)/documents/goldenChats/$(request.resource.data.chatId)).data.participantIds.size() == 2
        && request.resource.data.calleeUid in get(/databases/$(database)/documents/goldenChats/$(request.resource.data.chatId)).data.participantIds
        && request.resource.data.type in ['voice', 'video']
        && request.resource.data.status == 'ringing'
        && validCallDescription(request.resource.data.offer, 'offer')
        && request.resource.data.createdAt == request.time;
      allow update: if callParticipant(resource.data)
        && (
          (request.auth.uid == resource.data.calleeUid
            && resource.data.status == 'ringing'
            && request.resource.data.status == 'accepted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answer'])
            && validCallDescription(request.resource.data.answer, 'answer'))
          || (request.auth.uid == resource.data.calleeUid
            && resource.data.status == 'ringing'
            && request.resource.data.status == 'declined'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          || (resource.data.status in ['ringing', 'accepted']
            && request.resource.data.status == 'ended'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        );
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read: if callParticipant(get(/databases/$(database)/documents/calls/$(callId)).data);
        allow create: if callParticipant(get(/databases/$(database)/documents/calls/$(callId)).data)
          && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerUid
          && get(/databases/$(database)/documents/calls/$(callId)).data.status in ['ringing', 'accepted']
          && validCallCandidate(request.resource.data);
        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        allow read: if callParticipant(get(/databases/$(database)/documents/calls/$(callId)).data);
        allow create: if callParticipant(get(/databases/$(database)/documents/calls/$(callId)).data)
          && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid
          && get(/databases/$(database)/documents/calls/$(callId)).data.status == 'accepted'
          && validCallCandidate(request.resource.data);
        allow update, delete: if false;
      }
    }

    match /goldenChatMediaReservations/{chatId}/messages/{messageId} {
      allow read, write: if false;
    }

    match /quizQuestionCycles/{userId} {
      allow read, write: if false;

      match /questions/{questionId} {
        allow read, write: if false;
      }
    }

    match /quizDailyAwards/{awardId} {
      allow read, write: if false;
    }

    match /walletPurchases/{purchaseId} {
      allow read, write: if false;
    }

    match /referralProfiles/{userId} {
      allow read, write: if false;
    }

    match /referralCodes/{code} {
      allow read, write: if false;
    }

    match /referralAttributions/{userId} {
      allow read, write: if false;
    }

    match /referralAwards/{userId} {
      allow read, write: if false;
    }

    match /memberDirectory/{userId} {
      allow read, write: if false;
    }

    match /memberSearchLimits/{userId} {
      allow read, write: if false;
    }

    match /notificationProductQueue/{eventId} {
      allow read, write: if false;
    }

    match /notificationDigestJobs/{jobId} {
      allow read, write: if false;
    }

    match /notificationSettings/{settingId} {
      allow read, write: if false;
    }

    match /productDiscussions/{productId}/reactions/{userId} {
      allow get: if verifiedAccount() && request.auth.uid == userId;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /productDiscussions/{productId}/comments/{commentId} {
      allow read: if true;
      allow create: if verifiedAccount()
        && request.resource.data.keys().hasOnly([
          'authorUid',
          'authorName',
          'text',
          'voicePath',
          'parentCommentId',
          'createdAt'
        ])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 120
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.voicePath is string
        && request.resource.data.createdAt == request.time
        && (request.resource.data.voicePath == ''
          || request.resource.data.voicePath.matches(
            '^product-discussions/' + productId + '/voice/' + request.auth.uid + '/[A-Za-z0-9_-]+$'
          ))
        && (!request.resource.data.keys().hasAny(['parentCommentId'])
          || (request.resource.data.parentCommentId is string
            && request.resource.data.parentCommentId.matches('^[A-Za-z0-9_-]{1,128}$')
            && request.resource.data.parentCommentId != commentId
            && exists(/databases/$(database)/documents/productDiscussions/$(productId)/comments/$(request.resource.data.parentCommentId))))
        && (request.resource.data.text.size() > 0
          || request.resource.data.voicePath.size() > 0);
      allow update: if false;
      allow delete: if verifiedAccount() && resource.data.authorUid == request.auth.uid;
    }

    match /_reactionEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
